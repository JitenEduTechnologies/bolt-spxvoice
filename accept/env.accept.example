# Placeholder template for the local acceptance stack (copy to accept/.env.accept; that file is git-ignored).
ACCEPT_API_PORT=8015
ACCEPT_UI_PORT=3001
DATABASE_URL=postgresql+asyncpg://<db_user>:<db_password>@127.0.0.1:55444/<db_name>
REDIS_URL=redis://:<redis_password>@127.0.0.1:6384/0
ENVIRONMENT=test
PYTHONPATH=<candidate-root>
UVICORN_BASE_PORT=<port>
OSS_JWT_SECRET=<generate-a-long-random-string>
LIVEKIT_WORKER_MANAGED_BY_API=true
VOICE_RUNTIME=livekit
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=<livekit-dev-key>
LIVEKIT_API_SECRET=<livekit-dev-secret>
MINIO_ENDPOINT=<host:port>
MINIO_ACCESS_KEY=<minio-access-key>
MINIO_SECRET_KEY=<minio-secret-key>
MINIO_BUCKET=<bucket>
# Provider keys are NOT set here; enter a Gemini key in the dashboard (encrypted at rest).
