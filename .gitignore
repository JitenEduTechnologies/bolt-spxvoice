# Hardened .gitignore for the private Gate 2 WIP snapshot. Fails closed on secrets.

# --- Secrets and environment files (templates ending .example/.sample/.template are allowed) ---
.env
.env.*
*.env
*.env.*
!.env.example
!*.env.example
!.env.sample
!.env.template
!*.env.sample
!*.env.template
!env.*.example
accept/.env.accept
accept/run/
accept/logs/

# --- Keys, certificates, credentials, sessions ---
*.pem
*.key
*.crt
*.cert
*.p12
*.pfx
*.der
*.jks
*.keystore
certs/
config-encryption.key
telephony_encryption_key.txt
*credentials*.json
*secret*.json
*.token
.mcp.json
*.har
cookies*.txt
*cookies*.json
*session*.json
*.pid

# --- Dependencies and build output ---
node_modules/
.next/
.ui-verify/
.deps/
.pycache/
dist/
build/
out/
*.tsbuildinfo
.venv/
venv/
.turbo/
.cache/
coverage/
storybook-static/
playwright-report/
test-results/

# --- Python caches ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- Editors, agents, OS ---
.vscode/
.idea/
.claude/
.agents/
.DS_Store
Thumbs.db

# --- Runtime data, logs, browser profiles ---
*.log
logs/
api/.runtime/
dograh_pcm_cache/
chrome-profile/
browser-profile/
.playwright*/
tmp/
temp/

# --- Recordings, audio, media captures ---
*.wav
*.mp3
*.m4a
*.ogg
*.opus
*.pcm
*.flac
*.aac
*.webm
*.mp4
*.mov
*.avi
/recordings/
# --- Database dumps, backups, archives ---
*.dump
*.sql.gz
*.bak
*.backup
*.sqlite
*.sqlite3
*.db
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar
backups/

# --- Raw evidence, screenshots, captures (only sanitized checkpoint .md is kept) ---
evidence/**
!evidence/
!evidence/remediation/
!evidence/remediation/*.md
screenshot*.png
*login*.png
