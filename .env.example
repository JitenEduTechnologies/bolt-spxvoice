# Placeholder template only. Copy to api/.env and fill locally. NEVER commit real values.
ENVIRONMENT=local
DATABASE_URL=postgresql+asyncpg://<db_user>:<db_password>@localhost:5432/<db_name>
REDIS_URL=redis://:<redis_password>@localhost:6379/0
OSS_JWT_SECRET=<generate-a-long-random-string>
# Fernet key(s) for at-rest config encryption: `k2:<new>,k1:<old>` supports rotation.
TELEPHONY_CREDENTIALS_ENCRYPTION_KEYS=<fernet-key-generated-locally>
REQUIRE_CONFIG_ENCRYPTION=true
# LiveKit
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=<livekit-api-key>
LIVEKIT_API_SECRET=<livekit-api-secret>
LIVEKIT_WORKER_MANAGED_BY_API=true
VOICE_RUNTIME=livekit
# Storage
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=<minio-access-key>
MINIO_SECRET_KEY=<minio-secret-key>
MINIO_BUCKET=<bucket>
# Provider keys: prefer entering them in the dashboard (stored encrypted). Leave unset here.
# GOOGLE_API_KEY=<gemini-key>
# Operator-approved custom provider endpoints (https only), e.g. deepseek=https://gateway.example.org
# SPX_ADMIN_PROVIDER_ENDPOINTS=
